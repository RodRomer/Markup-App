# Copy to .env and fill in. Never commit the filled-in file -- .gitignore
# covers .env*, and the real values are not recoverable from Vercel once saved.
#
# Production values live in Vercel (Settings > Environment Variables). Those
# marked Secret there are write-only: Vercel cannot show them again, and its
# copy control gives you the variable NAME, not the value. This file is the
# list of what is needed, never the values themselves.

# Postgres (Neon). Vercel holds the production one as a Secret.
DATABASE_URL=

# Shared secret between Waystone/Rune and the staff API (/api/projects/*).
# Must be IDENTICAL in three places or the staff console gets 401:
#   1. here, for local dev
#   2. Vercel, as a Secret, for production
#   3. Waystone, in the Windows registry -- set it in Waystone's own settings,
#      NOT by editing a file. See Project-inator/KEYS.md.
MARKUP_STAFF_KEY=

# Vercel Blob, for page images. Only needed if uploading locally; in
# production Vercel injects it.
BLOB_READ_WRITE_TOKEN=

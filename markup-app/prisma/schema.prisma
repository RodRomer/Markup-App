// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String    @id @default(cuid())
  name         String
  /// The PPM project number, for linking this markup to its Keap opportunity.
  ///
  /// Kept apart from the name on purpose. The name is what a person calls the
  /// job -- "Bay Area Retail Fit-out" -- and deriving a number from it means
  /// guessing, which is exactly what puts "Delivered" beside a live project.
  /// Nullable: everything created before this field existed has no number, and
  /// falls back to whatever can be read off its name.
  projectNumber String?
  shareToken   String    @unique @default(cuid())
  status       String    @default("draft") // draft | sent | submitted
  allowIE      Boolean   @default(true)
  allowSection Boolean   @default(true)
  // Optional. When set, the client sees a running total for the IEs they place:
  // count x this. Null means the project simply does not show pricing, which is
  // different from a price of 0 -- so nullable rather than defaulted.
  pricePerIE   Float?
  createdAt    DateTime  @default(now())
  // Last time the client touched this project -- a marker placed, moved,
  // retyped or deleted, a reset, a submit or a reopen. Prisma's @updatedAt
  // would only follow writes to this row, and every one of those events
  // happens in the Marker table, so it is set explicitly instead.
  lastActivityAt DateTime @default(now())
  // Which team's work this is. Nullable because a project can outlive the
  // team that made it, and because the projects that existed before teams
  // did have no honest answer -- an unassigned project belongs to no team
  // and so appears on no team's list.
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([teamId])
}

/// Which tools a login may use in Waystone.
///
/// A grant belongs to a team or to one person, never both. The team grant is the
/// normal case; a member row is the exception that gives one person a tool their
/// team does not have, or takes one away that it does -- `allowed = false` beats
/// the team's grant.
///
/// A team with no grants at all gets everything. That is what lets this ship
/// without emptying anyone's rail: nothing changes until somebody starts saying
/// what a team should have, and from then on the list is exactly what they said.
model ToolGrant {
  id        String   @id @default(cuid())
  /// The tool's key as Waystone knows it: cache, lookup, snip, markup.
  tool      String
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([teamId, tool])
  @@unique([memberId, tool])
}

model Document {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalFilename String
  kind             String // image | pdf
  createdAt        DateTime @default(now())
  pages            Page[]
}

model Page {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber  Int
  imagePath   String
  width       Int
  height      Int
  /// A second, smaller render of the same page, for the editor to display.
  ///
  /// imagePath is 200 DPI so the export can be plotted at size; on a 36-inch
  /// sheet that is 7200px, and the browser shrinking it to fit averages each
  /// screen pixel over ~36 source pixels. A black hairline comes out pale grey
  /// -- measured at 85% of the ink lost -- and the decoded bitmap is 138 MB on
  /// whatever device the client happens to be holding.
  ///
  /// This one is rendered natively at display size rather than shrunk, so the
  /// lines keep their weight. Nullable: pages uploaded before it existed have
  /// only the full-resolution image, and the editor falls back to that.
  displayPath   String?
  displayWidth  Int?
  displayHeight Int?
  markers     Marker[]
}

model Marker {
  id         String            @id @default(cuid())
  pageId     String
  page       Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type       String // IE | SECTION | NOTE
  x          Float
  y          Float
  x2         Float? // SECTION's second endpoint (x/y is the first)
  y2         Float?
  flipped    Boolean           @default(false) // SECTION: which side the view flags point
  label      String
  note       String?
  boxWidth   Float? // NOTE: width of the revision callout box, as a fraction of page width
  createdAt  DateTime          @default(now())
  directions MarkerDirection[] // IE: 1-4 view-direction angles
}

model MarkerDirection {
  id       String @id @default(cuid())
  markerId String
  marker   Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  angle    Float // degrees, screen pixel-space atan2 convention (0 = right, 90 = down)
  order    Int
}

/// A group of staff who share one password, kept in a password manager rather
/// than issued per person. Deliberately the simplest thing that separates one
/// team's projects from another's; individual accounts can come later without
/// changing what a project belongs to.
model Team {
  id           String    @id @default(cuid())
  name         String    @unique
  /// scrypt, salted per team. Never the password itself, and never returned.
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
  sessions     Session[]
  members      Member[]
  toolGrants   ToolGrant[]
}

/// One person's sign-in. The team still decides which projects a session can
/// see; this is who opened it, so someone can be refused access on their own
/// rather than by changing a password everybody shares.
model Member {
  id           String    @id @default(cuid())
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Unique across the app, not per team: signing in takes a name and a
  /// password and nothing else, so two people cannot answer to one name.
  name         String    @unique
  /// scrypt, salted per person. Never the password itself, and never returned.
  passwordHash String
  /// Set rather than deleted, so a record of who did what outlives the person
  /// leaving. Their sessions go at the same time.
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  toolGrants   ToolGrant[]

  @@index([teamId])
}

/// A logged-in browser or Waystone install. Stored rather than signed so that
/// signing out actually revokes, and so no second server secret has to be kept
/// safe -- losing that secret is the failure this design is trying to avoid.
model Session {
  token     String   @id
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Who signed in, when they used their own login. Null for a session opened
  /// with the shared team password, which still works until everyone has one.
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([memberId])
}

// --- Warden: the overage check -------------------------------------------------
//
// Warden is the restricted admin tool in Waystone, and the overage check is its
// first job. The check runs here, where the Keap key is; Warden is where an admin
// reviews what it found and sends the emails from their own Outlook.

/// One run of the overage check, kept so Warden can show when it last ran and
/// what it saw -- and whether it failed, which is not the same as finding nothing.
model OverageRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  /// "cron" for the weekday morning run, "manual" for Run now in Warden.
  trigger    String
  /// Who pressed Run now. Null for the scheduled run.
  byMemberId String?
  ok         Boolean
  error      String?
  /// Every CAD Live project and its status -- the prototype's CSV, as rows.
  report     Json?

  @@index([ranAt])
}

/// One problem with one project: its SF missing, or over the overage threshold.
///
/// One row per project per kind, ever. That is what makes "once only" -- the
/// rule settled with the user -- hold across runs: once `sentAt` is set, no run
/// clears it and Warden never offers the alert again.
model OverageAlert {
  id             String    @id @default(cuid())
  /// Keap's opportunity id, which outlives any rename of the project.
  oppId          Int
  kind           String
  /// What the email is written from, as of the last run that saw the problem.
  projectNumber  String
  drafter        String
  pmEmail        String
  overage        Int?
  sfEst          Int?
  notesSf        Int?
  threshold      Int?
  businessDays   Int?
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  /// Set when a run stops seeing the problem; cleared if it comes back.
  resolvedAt     DateTime?
  /// Set when an admin claims it to send. Claimed, not confirmed: a claim that
  /// Outlook then fails is released, but a crash between the two loses an
  /// email rather than sending one twice.
  sentAt         DateTime?
  /// Kept as ids rather than relations: people are disabled, not deleted, and
  /// a record of who sent what should never cascade away with anybody.
  sentByMemberId String?
  sentTo         String?

  @@unique([oppId, kind])
  @@index([sentAt, resolvedAt])
}

/// Where a drafter's email goes. Keap's Drafter Name field holds names only, so
/// admins keep this list in Warden.
model DrafterEmail {
  id                String   @id @default(cuid())
  /// The name as matched: trimmed, single-spaced, lower case (drafterKey in
  /// src/lib/overage/compose.ts), so "Jane Smith " and "jane smith" are one.
  key               String   @unique
  /// The name as it was typed, for showing.
  name              String
  email             String
  updatedAt         DateTime @updatedAt
  updatedByMemberId String?
}
